# Genlixs environment (guide §6). Placeholders only — never commit real values.
# Set values in Vercel → Project → Settings → Environment Variables (separately for Production / Preview / Development)
# or in an ignored local .env.local file. Missing values disable the affected feature with an explicit error.

# --- Supabase (public: safe for the browser; the user's session decides access) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# --- Supabase (server only) ---
# Must point to the same project as NEXT_PUBLIC_SUPABASE_URL (checked by /api/internal/health).
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...). Workers, webhooks, upload verification, share links. SECRET.
SUPABASE_SECRET_KEY=

# --- Site ---
# Canonical origin used in auth emails and checkout return URLs. Must already resolve: today https://genlixs.vercel.app
APP_BASE_URL=http://localhost:3000

# --- KIE.ai generation provider (server only) ---
KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=
# HMAC key from the KIE dashboard used to verify callbacks. SECRET.
KIE_WEBHOOK_HMAC_KEY=
# Stable public origin KIE can reach (not a changing preview URL). Must already resolve: today https://genlixs.vercel.app
KIE_CALLBACK_BASE_URL=
# Reviewed provider media hosts the importer may download from (comma separated). Verify after the first real job.
MEDIA_FETCH_ALLOWED_HOSTS=tempfile.aiquickdraw.com,file.aiquickdraw.com,tempfile.redpandaai.co,file.redpandaai.co

# --- Workers (server only) ---
# Random 32+ byte token. The same value is stored in Supabase Vault as `genlixs_worker_token`. SECRET.
INTERNAL_WORKER_TOKEN=

# --- Partner referrals (server only) ---
# Random 32+ byte key that signs the first-party referral cookie. SECRET.
REFERRAL_COOKIE_SIGNING_KEY=

# --- Payments (server only) ---
# Empty = payments unavailable (checkout answers 503). `test` works only outside production.
BILLING_PROVIDER=
BILLING_API_SECRET=
BILLING_WEBHOOK_SECRET=

# --- Optional / not yet implemented adapters ---
TRANSACTIONAL_EMAIL_PROVIDER=
TRANSACTIONAL_EMAIL_API_KEY=
ERROR_TRACKING_DSN=

# --- Operational switches ---
GENERATION_PAUSED=false
ALLOW_PAID_PROVIDER_TESTS=false
# Deterministic fake provider for local/preview tests only. Ignored on the Vercel production environment.
GENLIXS_FAKE_PROVIDER=0
